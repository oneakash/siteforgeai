POSTGRES_USER=siteforge
POSTGRES_PASSWORD=siteforge
POSTGRES_DB=siteforge
DATABASE_URL=postgresql://siteforge:siteforge@localhost:5432/siteforge

# ---- API keys (set only the providers you use)
NVIDIA_API_KEY=        # build.nvidia.com
GROQ_API_KEY=
GOOGLE_API_KEY=        # Gemini API (chat + embeddings)

# ---- Default models, "provider:model_id" (can be changed at runtime via PUT /v1/models/overrides)
# LLM_REASONING=nvidia:nvidia/nemotron-3.5-super-vl-120b-a12b
LLM_REASONING=google:gemini-3.6-flash
# LLM_FAST=nvidia:nvidia/nemotron-3-ultra-550b-a55b
LLM_FAST=google:gemini-3.6-flash
# Tried in order if the chosen model fails transiently or its key is missing.
LLM_FALLBACKS=groq:openai/gpt-oss-120b,google:gemini-3.6-flash

# ---- Embeddings (output is always 1536-dim to match the vector(1536) column)
EMBEDDING_MODEL=google:gemini-embedding-2

# Origins allowed to call the API from a browser (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LangSearch API Key (Free tier: https://docs.langsearch.com/api)
# If left blank, the research phase is safely skipped and agents fall back to model_knowledge.
LANGSEARCH_API_KEY=your_langsearch_api_key_here

# Optional: Tune the research phase timeout (default 90 seconds)
RESEARCH_TIMEOUT_S=90