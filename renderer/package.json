{
  "name": "siteforge-renderer",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "build:css": "tailwindcss -i styles/input.css -o public/tailwind.css --minify",
    "dev:css": "tailwindcss -i styles/input.css -o public/tailwind.css --watch",
    "dev": "npm run build:css && node --watch server.js",
    "start": "node server.js",
    "test": "node --test"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
